{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "noEmit": true,

    // Only for tinybench, which vitest pulls in: its types name a DOM type and `lib` has no DOM.
    "skipLibCheck": true
  },
  "include": [
    "src",
    "tests",
    "scripts",
    "esbuild.config.ts",
    "oxfmt.config.ts",
    "oxlint.config.ts",
    "vitest.config.ts"
  ]
}
