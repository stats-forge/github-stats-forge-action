{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "noEmit": true,

    // Only for vitest 5.0.0's dangling .d.ts references; fixed upstream, drop on 5.0.1.
    // https://github.com/vitest-dev/vitest/issues/11140
    "skipLibCheck": true
  },
  "include": [
    "src",
    "tests",
    "esbuild.config.ts",
    "oxfmt.config.ts",
    "oxlint.config.ts",
    "vitest.config.ts"
  ]
}
