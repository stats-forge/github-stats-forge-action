{
  "name": "github-stats-forge-action",
  "version": "0.8.0",
  "private": true,
  "description": "Generate GitHub stats cards in GitHub Actions",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/stats-forge/github-stats-forge-action.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "build": "node esbuild.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint:oxlint": "oxlint",
    "lint:oxlint:ci": "oxlint --format=github",
    "lint:knip": "knip"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@stats-forge/github-stats-forge-core": "0.7.1"
  },
  "devDependencies": {
    "@marcalexiei/oxfmt-config": "1.3.0",
    "@marcalexiei/oxlint-config": "1.5.0",
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "knip": "6.35.1",
    "lefthook": "2.1.12",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c"
}
