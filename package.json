{
  "name": "github-stats-forge-action",
  "version": "0.15.0",
  "private": true,
  "description": "Generate GitHub stats cards in GitHub Actions",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/stats-forge/github-stats-forge-action.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "build": "node esbuild.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint:oxlint": "oxlint",
    "lint:oxlint:ci": "oxlint --format=github",
    "lint:knip": "knip",
    "changeset": "changeset",
    "changeset:version": "changeset version && oxfmt --write .",
    "release": "node scripts/release.ts"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@stats-forge/github-stats-forge-core": "0.16.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@marcalexiei/oxfmt-config": "2.0.1",
    "@marcalexiei/oxlint-config": "1.9.0",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "knip": "6.45.1",
    "lefthook": "2.2.1",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.20.0+sha512.6ccc74997ccef4e67999788e18dbfbfa583e2a849668668db4707b6a8306662f47156e650232a985bd3ec24cf9364c1aa154d37e51ed7aac62c1cd1e3afc80c3"
}
