{
  "name": "github-stats-forge-action",
  "version": "0.1.1",
  "private": true,
  "description": "Generate GitHub stats cards in GitHub Actions",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/stats-forge/github-stats-forge-action.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=esm --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --outfile=dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint:oxlint": "oxlint",
    "lint:oxlint:ci": "oxlint --format=github",
    "lint:knip": "knip"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@stats-forge/github-stats-forge-core": "0.0.2"
  },
  "devDependencies": {
    "@marcalexiei/oxfmt-config": "1.3.0",
    "@marcalexiei/oxlint-config": "1.5.0",
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "knip": "6.27.0",
    "lefthook": "2.1.12",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956"
}
